{
  "manifest_version": 3,
  "name": "Vrijedi.Ly",
  "version": "0.1.0",
  "description": "Ocjene oglasa, provjera prodavača i pomoć pri pregovoru na Njuškalu, Index oglasima i Facebook Marketplaceu.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Vrijedi.Ly",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.index.hr/oglasi/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.njuskalo.hr/*",
        "https://www.index.hr/oglasi/*",
        "https://www.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
